{
  "name": "qa-ai-challenge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "dev": "nx run-many --target=serve --projects=verification-api,verification-web --parallel=2",
    "dev:api": "nx serve verification-api",
    "dev:web": "nx serve verification-web",
    "build": "nx run-many --target=build --projects=verification-api,verification-web",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "echo '\\nNo verification-e2e project yet — generate one under apps/verification-e2e and add its e2e target. See CHALLENGE.md.\\n' && exit 1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "nx": "20.1.2",
    "tsx": "^4.19.0",
    "typescript": "~5.5.4",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
